iblens.com, www.iblens.com {
    # 3000 takes traffic; 3001 (iblens-b) answers while 3000 restarts (scripts/restart.sh).
    reverse_proxy host.docker.internal:3000 host.docker.internal:3001 {
        lb_policy first
        lb_try_duration 15s
        lb_try_interval 250ms
        fail_duration 5s
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
    }
}
